rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Solo il proprietario, con email confermata (gli account email + password) o login Google.
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && (request.auth.token.email_verified == true
          || request.auth.token.firebase.sign_in_provider == 'google.com');
    }
    match /users/{uid}/decks/{deckId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && request.resource.data.cards.size() <= 500;
    }
  }
}

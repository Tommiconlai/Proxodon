rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Account con email confermata (gli account email + password) o login Google.
    function verified() {
      return request.auth != null
        && (request.auth.token.email_verified == true
          || request.auth.token.firebase.sign_in_provider == 'google.com');
    }
    // Solo il proprietario, verificato.
    function owner(uid) {
      return verified() && request.auth.uid == uid;
    }
    // Profilo: foto (JPEG 256 px) e sfondo (JPEG fino a 1500 px) come data URL di un'immagine, nickname. Il
    // nickname deve essere suo in usernames/ a fine scrittura (getAfter: stessa transazione di claimNickname).
    // followers / following non li scrive il client.
    function image(s, max) {
      return s is string && s.size() <= max && s.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+');
    }
    // since = iscrizione (dall'account, la scrive il proprietario aprendo il suo profilo): la mostra la pagina pubblica.
    function validProfile(uid, d) {
      return d.keys().hasOnly(['photo', 'banner', 'nickname', 'updatedAt', 'since'])
        && d.get('updatedAt', request.time) is timestamp
        && d.get('since', request.time) is timestamp && d.get('since', request.time) <= request.time
        && (d.get('photo', null) == null || image(d.photo, 200000))
        && (d.get('banner', null) == null || image(d.banner, 600000))
        && (d.get('nickname', null) == null || (d.nickname is string
          && getAfter(/databases/$(db)/documents/usernames/$(d.nickname.lower())).data.uid == uid));
    }
    // Cambiando nickname il vecchio si libera nella stessa scrittura (claimNickname): un account ne tiene uno solo.
    function nickFreed(d) {
      let old = resource.data.get('nickname', null);
      return old == null
        || (d.get('nickname', null) is string && d.nickname.lower() == old.lower())
        || !existsAfter(/databases/$(db)/documents/usernames/$(old.lower()));
    }
    // Cancellare il profilo libera anche il nickname (stessa scrittura, deleteUserData): sennò, ricreato il profilo con
    // un altro nome, l'account firmerebbe ancora col vecchio.
    // Il profilo (nickname, foto, sfondo, iscrizione: niente email) lo legge chi ha un account, per la pagina pubblica;
    // l'elenco degli utenti no.
    match /users/{uid} {
      allow get: if verified();
      allow delete: if owner(uid) && (resource == null || resource.data.get('nickname', null) == null
        || !existsAfter(/databases/$(db)/documents/usernames/$(resource.data.nickname.lower())));
      allow create: if owner(uid) && validProfile(uid, request.resource.data);
      allow update: if owner(uid) && validProfile(uid, request.resource.data) && nickFreed(request.resource.data);
    }
    // Impostazioni dell'account (pagina Settings): un documento solo, prefs = { s, at }, solo del proprietario. s è una
    // mappa che il client ripulisce leggendola (cleanSettings: solo le chiavi note, col tipo giusto), at l'ora del server.
    match /users/{uid}/settings/{docId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && docId == 'prefs'
        && request.resource.data.keys().hasOnly(['s', 'at']) && request.resource.data.s is map
        && request.resource.data.at == request.time;
    }
    // Le date "at" (tracce, like, voti, risposte) sono sempre l'ora del server: nessuno le sceglie.
    // Dilemmi a cui l'account ha risposto (contatore del profilo): solo suoi.
    match /users/{uid}/answered/{id} {
      allow read, delete: if owner(uid);
      // Solo insieme al voto (stesso batch) e con l'id {deck}_{dilemma}: il contatore non si gonfia.
      allow create: if owner(uid) && request.resource.data.keys().hasOnly(['deck', 'dilemma', 'at'])
        && request.resource.data.at == request.time
        && id == request.resource.data.deck + '_' + request.resource.data.dilemma
        && existsAfter(/databases/$(db)/documents/publicDecks/$(request.resource.data.deck)/dilemmas/$(request.resource.data.dilemma)/votes/$(uid));
    }
    // Help request a cui l'account ha risposto: solo sue, solo insieme alla risposta (stesso batch), id {deck}_{help}.
    match /users/{uid}/replied/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['deck', 'help', 'at'])
        && request.resource.data.at == request.time
        && id == request.resource.data.deck + '_' + request.resource.data.help
        && existsAfter(/databases/$(db)/documents/publicDecks/$(request.resource.data.deck)/helps/$(request.resource.data.help)/replies/$(uid));
    }
    // Follow: users/{uid}/following/{them} e users/{them}/followers/{uid}, sempre insieme (existsAfter, stesso batch),
    // id = gli account, mai sé stessi, data del server. Li legge chi ha un account (conteggi della pagina pubblica). Li
    // toglie chi segue, oppure chi è seguito (si toglie dai seguiti degli altri cancellando l'account).
    function account(id) {
      return id.matches('[A-Za-z0-9]{20,128}');
    }
    match /users/{uid}/following/{them} {
      allow read: if verified();
      allow create: if owner(uid) && them != uid && account(them)
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time
        && existsAfter(/databases/$(db)/documents/users/$(them)/followers/$(uid));
      allow delete: if owner(uid) || owner(them);
    }
    match /users/{uid}/followers/{who} {
      allow read: if verified();
      allow create: if owner(who) && who != uid && account(uid)
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time
        && existsAfter(/databases/$(db)/documents/users/$(who)/following/$(uid));
      allow delete: if owner(who) || owner(uid);
    }
    // Like dati dall'account: la traccia per toglierli cancellando l'account, solo insieme al like (stesso batch).
    match /users/{uid}/liked/{deckId} {
      allow read, delete: if owner(uid);
      allow create: if owner(uid) && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time
        && existsAfter(/databases/$(db)/documents/publicDecks/$(deckId)/likes/$(uid));
    }
    // Commander bracket (mazzo e copia pubblica): 1-5 scelto a mano, 0 spento, assente = automatico (calcolato dal client).
    function bracket(d) {
      return d.get('bracket', 0) is int && d.get('bracket', 0) >= 0 && d.get('bracket', 0) <= 5;
    }
    // Analisi delle terre (solo mazzo privato): override per carta (lista, max come le righe) e settings dell'analisi.
    function landAnalysis(d) {
      let la = d.get('landAnalysis', {});
      return la is map && la.keys().hasOnly(['overrides', 'settings'])
        && la.get('overrides', []) is list && la.get('overrides', []).size() <= 500
        && la.get('settings', {}) is map && la.get('settings', {}).keys().hasOnly(['format', 'cheap', 'fast', 'cmdr', 'play']);
    }
    // Mazzi: rev = revisione, +1 a ogni scrittura. Si accetta solo la revisione che segue quella salvata: un
    // dispositivo con una copia vecchia (cache non aggiornata) non sovrascrive quella nuova, la sua scrittura è
    // rifiutata e lui torna alla versione salvata. I mazzi di prima, senza rev, valgono 0. Un mazzo nasce con rev 1:
    // il salvataggio di una copia vecchia di un mazzo cancellato altrove non lo fa rinascere. ver: versione nuova a ogni
    // salvataggio dell'editor, base = la ver da cui parte; deve essere quella salvata, così con più salvataggi in coda
    // (offline) cadono tutti dopo il primo rifiutato (il secondo, rev + 2, passerebbe). ver invariata (cartelle, app
    // di prima): conta solo rev.
    // Solo i campi che scrive il client (payload, changes, createDeck, cartelle, versioni), nome e cartella corti.
    function validDeck(d) {
      return d.keys().hasOnly(['v', 'name', 'format', 'groupBy', 'sections', 'cover', 'cards', 'tags', 'public',
          'updatedAt', 'sig', 'changedAt', 'createdAt', 'folder', 'rev', 'ver', 'base', 'bracket', 'landAnalysis'])
        && bracket(d) && landAnalysis(d) && d.get('v', 1) == 1 && d.get('createdAt', request.time) is timestamp
        && d.cards is list && d.cards.size() <= 500
        && d.get('sections', []) is list && d.get('sections', []).size() <= 100
        && d.get('tags', []) is list && d.get('tags', []).size() <= 10
        && d.get('name', '') is string && d.get('name', '').size() <= 200
        && d.get('format', '') is string && d.get('format', '').size() <= 20
        && d.get('ver', '') is string && d.get('ver', '').size() <= 64
        && (d.get('base', null) == null || (d.base is string && d.base.size() <= 64))
        && (d.get('folder', null) == null || (d.folder is map && d.folder.keys().hasOnly(['id', 'name'])
          && d.folder.id is string && d.folder.id.size() <= 64 && d.folder.name is string && d.folder.name.size() <= 80));
    }
    match /users/{uid}/decks/{deckId} {
      allow read, delete: if owner(uid);
      allow create: if owner(uid) && validDeck(request.resource.data) && request.resource.data.get('rev', 0) == 1;
      allow update: if owner(uid) && validDeck(request.resource.data)
        && request.resource.data.get('rev', 0) == resource.data.get('rev', 0) + 1
        && (request.resource.data.get('ver', null) == resource.data.get('ver', null)
          || request.resource.data.get('base', null) == resource.data.get('ver', null));
    }
    // Community: copia pubblica di un mazzo (stesso id), la legge chi ha un account. Solo i campi che scrive il client,
    // del tipo giusto (le righe le ripulisce chi legge: cleanPublicDeck); createdAt una data vera e non futura (5 minuti
    // di margine per l'orologio del dispositivo), così nessuno resta in cima alla lista. La firma (owner) è il nickname
    // dell'autore in usernames/, o nessuna.
    // Le regole non hanno cicli, quindi le liste corte si controllano posizione per posizione. Le righe del
    // mazzo (fino a 500) e le sezioni restano senza controllo per elemento (join non accetta mappe); words ha un tetto
    // con join. Il feed della Community non legge le copie piene ma l'indice leggero (publicIndex, sotto).
    function str(l, i, max) {
      return l.size() <= i || (l[i] is string && l[i].size() <= max);
    }
    function strs(l, max) {
      return l is list && l.size() <= 10 && str(l, 0, max) && str(l, 1, max) && str(l, 2, max) && str(l, 3, max)
        && str(l, 4, max) && str(l, 5, max) && str(l, 6, max) && str(l, 7, max) && str(l, 8, max) && str(l, 9, max);
    }
    // Carta di dilemmi e help request (dilemmaCard nel client): solo questi 7 campi (7 chiavi, e il + di un campo che
    // manca o non è una stringa è un errore, quindi un rifiuto), insieme al massimo 1400 caratteri. Le carte delle
    // risposte (fino a 500 + 500) non si controllano una per una: le ripulisce chi legge (cleanReply).
    function card(c) {
      return c.size() == 7 && (c.name + c.img + c.back + c.sid + c.oid + c.set + c.cn).size() <= 1400;
    }
    function cards(l, max) {
      let n = l.size();
      return l is list && n <= max && (n < 1 || card(l[0])) && (n < 2 || card(l[1])) && (n < 3 || card(l[2]))
        && (n < 4 || card(l[3])) && (n < 5 || card(l[4])) && (n < 6 || card(l[5])) && (n < 7 || card(l[6]))
        && (n < 8 || card(l[7])) && (n < 9 || card(l[8])) && (n < 10 || card(l[9]));
    }
    function validPublic(d) {
      return d.uid == request.auth.uid
        && d.keys().hasOnly(['v', 'name', 'format', 'groupBy', 'sections', 'cover', 'cards', 'tags', 'public',
          'updatedAt', 'sig', 'changedAt', 'uid', 'owner', 'words', 'createdAt', 'bracket'])
        && bracket(d) && d.get('v', 1) == 1
        && d.name is string && d.name.size() <= 200
        && d.format is string && d.format.size() <= 20
        && d.get('groupBy', '') is string && d.get('groupBy', '').size() <= 20
        && (d.get('cover', null) == null || (d.cover is string && d.cover.size() <= 64))
        && d.get('sig', '') is string && d.get('sig', '').size() <= 16
        && d.get('public', true) is bool
        && d.get('updatedAt', request.time) is timestamp && d.get('changedAt', request.time) is timestamp
        && d.cards is list && d.cards.size() <= 500
        && d.words is list && d.words.size() <= 200 && d.words.join(' ').size() <= 4400
        && strs(d.get('tags', []), 40)
        && d.get('sections', []) is list && d.get('sections', []).size() <= 100
        && d.createdAt is timestamp && d.createdAt <= request.time + duration.value(5, 'm')
        && (d.get('owner', null) == null || (d.owner is string
          && get(/databases/$(db)/documents/usernames/$(d.owner.lower())).data.uid == request.auth.uid));
    }
    // Copia ritirata (Make private, mazzo cancellato): resta solo { uid }, così l'id non lo prende nessun altro.
    function retired(d) {
      return d.keys().hasOnly(['uid']) && d.uid == request.auth.uid;
    }
    function validDilemma(d) {
      return d.keys().hasOnly(['uid', 'question', 'cards', 'createdAt'])
        && d.question is string && d.question.size() > 0 && d.question.size() <= 280
        && cards(d.cards, 4) && d.cards.size() >= 2;
    }
    function validVote(d) {
      return d.keys().hasOnly(['pick', 'why', 'owner', 'at'])
        && d.pick is int && d.pick >= 0 && d.pick <= 3
        && d.why is string && d.why.size() <= 500
        && (d.get('owner', null) == null || (d.owner is string
          && get(/databases/$(db)/documents/usernames/$(d.owner.lower())).data.uid == request.auth.uid));
    }
    // Il mazzo copiato sulla richiesta quando nasce (per il feed): nome, firma, formato, copertina. La firma deve
    // essere il nickname di chi scrive, come nella copia pubblica. Solo alla creazione: dopo non cambia (update).
    function validHelpDeck(d) {
      return d.get('deck', null) == null || (d.deck is map
        && d.deck.keys().hasOnly(['name', 'owner', 'format', 'cover'])
        && d.deck.name is string && d.deck.name.size() <= 80
        && d.deck.format is string && d.deck.format.size() <= 20
        && d.deck.cover is string && d.deck.cover.size() <= 500
        && (d.deck.get('owner', null) == null || (d.deck.owner is string
          && get(/databases/$(db)/documents/usernames/$(d.deck.owner.lower())).data.uid == request.auth.uid)));
    }
    function validHelp(d) {
      return d.keys().hasOnly(['uid', 'kind', 'text', 'cards', 'status', 'applied', 'seenAt', 'createdAt', 'deck'])
        && d.kind in ['cuts', 'upgrades', 'budget', 'mana', 'synergy', 'other']
        && d.text is string && d.text.size() > 0 && d.text.size() <= 500
        && d.cards is list && d.cards.size() <= 10
        && d.status in ['open', 'solved']
        && d.applied is list && d.applied.size() <= 200;
    }
    // Risposta: testo (max 1000) e/o carte da aggiungere e da togliere, senza limite per chi risponde (500 + 500, le
    // righe di un mazzo, solo come tetto; il documento resta sotto 1 MiB); la firma come nei voti.
    function validReply(d) {
      return d.keys().hasOnly(['text', 'add', 'cut', 'owner', 'at'])
        && d.text is string && d.text.size() <= 1000
        && d.add is list && d.add.size() <= 500 && d.cut is list && d.cut.size() <= 500
        && (d.text.size() > 0 || d.add.size() > 0 || d.cut.size() > 0)
        && (d.get('owner', null) == null || (d.owner is string
          && get(/databases/$(db)/documents/usernames/$(d.owner.lower())).data.uid == request.auth.uid));
    }
    // La copia piena si scrive solo finché il mazzo privato è pubblico: un publish arrivato dopo Make private o Delete
    // (salvataggio ancora in volo, coda offline) non riporta il mazzo in Community.
    function stillPublic(deckId) {
      return get(/databases/$(db)/documents/users/$(request.auth.uid)/decks/$(deckId)).data.get('public', false) == true;
    }
    // Indice leggero della Community (publicIndex/{id}, stesso id della copia): quello che servono i riquadri e i filtri,
    // ogni campo con un tetto (join su words: lunghezza totale e solo valori semplici), così il feed legge 60 documenti
    // piccoli invece di 60 copie piene, le cui righe non si possono controllare una per una (join non accetta mappe).
    // Lo scrive il proprietario della copia (ownCopy, niente id presi da altri), finché il mazzo è pubblico.
    function validIndex(d) {
      return d.uid == request.auth.uid
        && d.keys().hasOnly(['uid', 'name', 'format', 'owner', 'tags', 'words', 'ci', 'art', 'names', 'createdAt', 'changedAt', 'bracket'])
        && (d.get('bracket', null) == null || (d.bracket is int && d.bracket >= 1 && d.bracket <= 5))
        && d.name is string && d.name.size() <= 200
        && d.format is string && d.format.size() <= 20
        && strs(d.get('tags', []), 40)
        && d.words is list && d.words.size() <= 200 && d.words.join(' ').size() <= 4400
        && d.get('ci', '') is string && d.get('ci', '').size() <= 5
        && d.get('art', '') is string && d.get('art', '').size() <= 500
        && d.get('names', '') is string && d.get('names', '').size() <= 16000
        && d.createdAt is timestamp && d.createdAt <= request.time + duration.value(5, 'm')
        && d.get('changedAt', request.time) is timestamp
        && (d.get('owner', null) == null || (d.owner is string
          && get(/databases/$(db)/documents/usernames/$(d.owner.lower())).data.uid == request.auth.uid));
    }
    // Copia vera (con le carte), non il segnaposto { uid } di un mazzo ritirato: niente riquadri senza mazzo dietro.
    function ownCopy(deckId) {
      let c = getAfter(/databases/$(db)/documents/publicDecks/$(deckId)).data;
      return c.uid == request.auth.uid && 'cards' in c;
    }
    // Id nuovi solo come quelli di Firestore (20 lettere e cifre): un id scritto a mano romperebbe link e percorsi.
    function autoId(id) {
      return id.matches('[A-Za-z0-9]{20}');
    }
    match /publicIndex/{deckId} {
      allow get: if verified();
      allow list: if verified() && ((request.query.limit != null && request.query.limit <= 60)
        || resource.data.uid == request.auth.uid);
      allow create: if verified() && autoId(deckId) && validIndex(request.resource.data) && stillPublic(deckId) && ownCopy(deckId);
      allow update: if verified() && resource.data.uid == request.auth.uid && validIndex(request.resource.data)
        && stillPublic(deckId) && ownCopy(deckId) && request.resource.data.createdAt <= resource.data.createdAt;
      allow delete: if verified() && (resource == null || resource.data.uid == request.auth.uid);
    }
    // applied cresce di una chiave alla volta (uid@ora, corta): la richiesta nasce vuota, così nessun elemento è grosso.
    function appliedOk(added) {
      return added.size() == 0 || (added.size() == 1 && added[0] is string && added[0].size() <= 100);
    }
    match /publicDecks/{deckId} {
      allow get: if verified();
      // Elenchi: al massimo 60 alla volta (la Community), oppure solo le proprie copie (firma nuova, cancellazione dell'account).
      allow list: if verified() && ((request.query.limit != null && request.query.limit <= 60)
        || resource.data.uid == request.auth.uid);
      allow create: if verified() && autoId(deckId)
        && ((validPublic(request.resource.data) && stillPublic(deckId)) || retired(request.resource.data));
      // createdAt non si sposta in avanti (resterebbe in cima alla Community): uguale o prima (la data del mazzo
      // privato, che nasce un attimo prima della copia).
      allow update: if verified() && resource.data.uid == request.auth.uid
        && (retired(request.resource.data) || (validPublic(request.resource.data) && stillPublic(deckId)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt <= resource.data.createdAt)));
      allow delete: if verified() && (resource == null || resource.data.uid == request.auth.uid);
      // Like: uno per account (id = uid), non al proprio mazzo né a una copia ritirata, con la sua traccia in
      // users/{uid}/liked (stesso batch); il conteggio è una query (list). Li toglie chi li ha dati o il proprietario
      // del mazzo quando lo ritira.
      match /likes/{uid} {
        allow read: if verified();
        allow create: if owner(uid) && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time
          && get(/databases/$(db)/documents/publicDecks/$(deckId)).data.uid != uid
          && 'cards' in get(/databases/$(db)/documents/publicDecks/$(deckId)).data
          && existsAfter(/databases/$(db)/documents/users/$(uid)/liked/$(deckId));
        allow delete: if owner(uid) || (verified()
          && get(/databases/$(db)/documents/publicDecks/$(deckId)).data.uid == request.auth.uid);
      }
      // Dilemmi: li crea e cancella il proprietario del mazzo pubblico (domanda 1-280 caratteri, da 2 a 4 carte, data del
      // server: una data futura lo terrebbe in cima al feed), li legge chi ha un account. Voti: uno per account (id = uid),
      // mai sul proprio dilemma, con la traccia in users/{uid}/answered (stesso batch); dopo il voto cambia solo la
      // spiegazione (why, max 500); la firma (owner) è il nickname di chi vota o nessuna; li cancella chi ha votato o il
      // proprietario del dilemma (quando lo cancella).
      match /dilemmas/{dId} {
        allow read: if verified();
        allow create: if verified() && autoId(dId) && request.resource.data.uid == request.auth.uid
          && get(/databases/$(db)/documents/publicDecks/$(deckId)).data.uid == request.auth.uid
          && 'cards' in get(/databases/$(db)/documents/publicDecks/$(deckId)).data
          && request.resource.data.createdAt == request.time
          && validDilemma(request.resource.data);
        allow delete: if verified() && resource.data.uid == request.auth.uid;
        match /votes/{uid} {
          allow read: if verified();
          // pick = una delle carte del dilemma (stesso get: Firestore lo legge una volta sola).
          allow create: if owner(uid) && validVote(request.resource.data) && request.resource.data.at == request.time
            && get(/databases/$(db)/documents/publicDecks/$(deckId)/dilemmas/$(dId)).data.uid != uid
            && request.resource.data.pick < get(/databases/$(db)/documents/publicDecks/$(deckId)/dilemmas/$(dId)).data.cards.size()
            && existsAfter(/databases/$(db)/documents/users/$(uid)/answered/$(deckId + '_' + dId));
          // Solo why: la firma salvata non si ricontrolla (chi ha cambiato nickname può ancora spiegare).
          allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['why'])
            && request.resource.data.why is string && request.resource.data.why.size() <= 500;
          allow delete: if owner(uid) || (verified()
            && get(/databases/$(db)/documents/publicDecks/$(deckId)/dilemmas/$(dId)).data.uid == request.auth.uid);
        }
      }
      // Help request: le crea il proprietario del mazzo pubblico, le legge chi ha un account; dopo cambiano solo
      // status (open / solved), applied e seenAt, sempre del proprietario, che può cancellarle. Risposte: una
      // per account (id = uid), mai sulla propria richiesta, solo finché è aperta, con la traccia in
      // users/{uid}/replied (stesso batch); le cancella chi ha risposto o il proprietario della richiesta.
      match /helps/{hId} {
        allow read: if verified();
        // Date del server (createdAt, seenAt): una data futura terrebbe la richiesta in cima al feed.
        allow create: if verified() && autoId(hId) && request.resource.data.uid == request.auth.uid
          && get(/databases/$(db)/documents/publicDecks/$(deckId)).data.uid == request.auth.uid
          && 'cards' in get(/databases/$(db)/documents/publicDecks/$(deckId)).data
          && request.resource.data.status == 'open' && request.resource.data.applied.size() == 0
          && request.resource.data.createdAt == request.time && request.resource.data.seenAt == request.time
          && validHelp(request.resource.data) && cards(request.resource.data.cards, 10) && validHelpDeck(request.resource.data);
        allow update: if verified() && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'applied', 'seenAt'])
          && (!('seenAt' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.seenAt == request.time)
          && validHelp(request.resource.data) && appliedOk(request.resource.data.applied.removeAll(resource.data.applied));
        allow delete: if verified() && resource.data.uid == request.auth.uid;
        match /replies/{uid} {
          allow read: if verified();
          // at = ora del server: senza data la risposta sparirebbe dall'elenco (ordinato per at), con una futura resterebbe sempre "new".
          allow create, update: if owner(uid) && validReply(request.resource.data) && request.resource.data.at == request.time
            && get(/databases/$(db)/documents/publicDecks/$(deckId)/helps/$(hId)).data.uid != uid
            && get(/databases/$(db)/documents/publicDecks/$(deckId)/helps/$(hId)).data.status == 'open'
            && existsAfter(/databases/$(db)/documents/users/$(uid)/replied/$(deckId + '_' + hId));
          allow delete: if owner(uid) || (verified()
            && get(/databases/$(db)/documents/publicDecks/$(deckId)/helps/$(hId)).data.uid == request.auth.uid);
        }
      }
    }
    // Feed della scheda Dilemmas: query collection group sui dilemmi di tutti i mazzi, solo lettura e al massimo 60
    // alla volta (le scritture e le letture di un mazzo restano quelle di publicDecks/{deckId}/dilemmas sopra).
    match /{path=**}/dilemmas/{dId} {
      allow read: if verified() && request.query.limit != null && request.query.limit <= 60;
    }
    // Feed della scheda Help, come quello dei dilemmi.
    match /{path=**}/helps/{hId} {
      allow read: if verified() && request.query.limit != null && request.query.limit <= 60;
    }
    // Liste di gruppo (My decks): le legge chi è tra i membri (al massimo 20, il creatore sempre dentro). Il creatore
    // (owner) rinomina, invita e toglie membri, attiva o ritira il link d'invito (invite) e la elimina: prima deleted, poi
    // via le carte, poi la lista. Un membro esce togliendo solo sé stesso. Col link entra chi scrive joinKey uguale a
    // invite e aggiunge solo sé stesso. updatedAt è l'ora del server.
    function validList(d) {
      return d.keys().hasOnly(['owner', 'name', 'members', 'invite', 'joinKey', 'deleted', 'createdAt', 'updatedAt'])
        && d.owner is string && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.members is list && d.members.size() <= 20 && d.owner in d.members
        && (d.get('invite', null) == null || (d.invite is string && d.invite.size() >= 20 && d.invite.size() <= 40))
        && (d.get('joinKey', null) == null || (d.joinKey is string && d.joinKey.size() <= 40))
        && d.get('deleted', false) is bool
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /groupLists/{listId} {
      allow read: if verified() && request.auth.uid in resource.data.members;
      allow create: if verified() && autoId(listId) && validList(request.resource.data)
        && request.resource.data.owner == request.auth.uid && request.resource.data.members == [request.auth.uid]
        && request.resource.data.createdAt == request.time
        && !('joinKey' in request.resource.data) && request.resource.data.get('deleted', false) == false;
      allow update: if verified() && validList(request.resource.data)
        && request.resource.data.owner == resource.data.owner && request.resource.data.createdAt == resource.data.createdAt
        && (resource.data.owner == request.auth.uid
          || (request.auth.uid in resource.data.members
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
            && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet()))
          || (!(request.auth.uid in resource.data.members) && resource.data.get('deleted', false) == false
            && resource.data.get('invite', null) != null && request.resource.data.get('joinKey', null) == resource.data.invite
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinKey', 'updatedAt'])
            && request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet())));
      allow delete: if verified() && resource.data.owner == request.auth.uid;
      // Carte: le legge ogni membro; le aggiunge un membro (firmate col suo uid, il nickname come nei voti, la carta come
      // quelle dei dilemmi, 1-99 copie, data del server); copie ed edizione (la stessa carta: stesso oid) le cambia e la
      // riga la toglie solo chi l'ha messa. Il creatore toglie quelle degli altri solo se non sono più membri o mentre
      // elimina la lista (deleted).
      match /cards/{rowId} {
        function list() {
          return get(/databases/$(db)/documents/groupLists/$(listId)).data;
        }
        allow read: if verified() && request.auth.uid in list().members;
        allow create: if verified() && request.auth.uid in list().members && list().get('deleted', false) == false
          && request.resource.data.keys().hasOnly(['uid', 'owner', 'card', 'qty', 'at'])
          && request.resource.data.uid == request.auth.uid && request.resource.data.at == request.time
          && request.resource.data.qty is int && request.resource.data.qty >= 1 && request.resource.data.qty <= 99
          && request.resource.data.card is map && card(request.resource.data.card)
          && (request.resource.data.get('owner', null) == null || (request.resource.data.owner is string
            && get(/databases/$(db)/documents/usernames/$(request.resource.data.owner.lower())).data.uid == request.auth.uid));
        allow update: if verified() && resource.data.uid == request.auth.uid && request.auth.uid in list().members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty', 'card'])
          && request.resource.data.qty is int && request.resource.data.qty >= 1 && request.resource.data.qty <= 99
          && request.resource.data.card is map && card(request.resource.data.card)
          && request.resource.data.card.oid == resource.data.card.oid;
        allow delete: if verified() && (resource.data.uid == request.auth.uid
          || (list().owner == request.auth.uid && (list().get('deleted', false) == true || !(resource.data.uid in list().members))));
      }
    }
    // Team Trios (My decks): teams/{id} = { owner (il team leader), name, members (al massimo 3, il leader sempre
    // dentro), slots: i tre posti mazzo (uid di un membro o null; il posto 0 è del leader), deleted?, createdAt,
    // updatedAt }. La legge chi è tra i membri. Il leader rinomina, dà e toglie i posti (coi membri) e la elimina: prima
    // deleted, poi via i mazzi, poi la squadra. Un membro esce togliendo solo sé stesso, dai membri e dal suo posto.
    function validTeam(d) {
      return d.keys().hasOnly(['owner', 'name', 'members', 'slots', 'deleted', 'createdAt', 'updatedAt'])
        && d.owner is string && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.members is list && d.members.size() <= 3 && d.owner in d.members
        && d.slots is list && d.slots.size() == 3 && d.slots[0] == d.owner
        && (d.slots[1] == null || d.slots[1] in d.members) && (d.slots[2] == null || d.slots[2] in d.members)
        && d.get('deleted', false) is bool
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /teams/{teamId} {
      // Il posto i dopo l'uscita di chi scrive: vuoto se era suo, sennò com'era.
      function left(i) {
        return (resource.data.slots[i] == request.auth.uid && request.resource.data.slots[i] == null)
          || (resource.data.slots[i] != request.auth.uid && request.resource.data.slots[i] == resource.data.slots[i]);
      }
      allow read: if verified() && request.auth.uid in resource.data.members;
      allow create: if verified() && autoId(teamId) && validTeam(request.resource.data)
        && request.resource.data.owner == request.auth.uid && request.resource.data.members == [request.auth.uid]
        && request.resource.data.slots == [request.auth.uid, null, null]
        && request.resource.data.createdAt == request.time && request.resource.data.get('deleted', false) == false;
      allow update: if verified() && validTeam(request.resource.data)
        && request.resource.data.owner == resource.data.owner && request.resource.data.createdAt == resource.data.createdAt
        && (resource.data.owner == request.auth.uid
          || (request.auth.uid in resource.data.members
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'slots', 'updatedAt'])
            && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet())
            && left(0) && left(1) && left(2)));
      allow delete: if verified() && resource.data.owner == request.auth.uid;
      // Mazzi: teams/{id}/decks/{0|1|2}, come i mazzi personali (validDeck, rev e ver) ma mai pubblici. Li legge ogni
      // membro; li crea e cambia il leader o il giocatore di quel posto (non in una squadra in eliminazione), che li toglie.
      match /decks/{slot} {
        function team() {
          return get(/databases/$(db)/documents/teams/$(teamId)).data;
        }
        function editor() {
          return verified() && (team().owner == request.auth.uid || team().slots[int(slot)] == request.auth.uid);
        }
        allow read: if verified() && request.auth.uid in team().members;
        allow create: if slot in ['0', '1', '2'] && editor() && team().get('deleted', false) == false
          && validDeck(request.resource.data) && request.resource.data.get('rev', 0) == 1
          && request.resource.data.get('public', false) == false;
        allow update: if editor() && team().get('deleted', false) == false && validDeck(request.resource.data)
          && request.resource.data.get('public', false) == false
          && request.resource.data.get('rev', 0) == resource.data.get('rev', 0) + 1
          && (request.resource.data.get('ver', null) == resource.data.get('ver', null)
            || request.resource.data.get('base', null) == resource.data.get('ver', null));
        allow delete: if editor();
      }
    }
    // Nickname unici: usernames/{nome in minuscolo} = { uid }. Lo legge chi ha un account (per sapere
    // se è libero, mai l'elenco), lo prende chi lo trova libero e lo mette nel proprio profilo nella stessa
    // scrittura (uno per account, vedi nickFreed), lo libera solo il proprietario. Alcuni nomi sono riservati.
    match /usernames/{name} {
      allow get: if verified();
      allow create: if owner(request.resource.data.uid)
        && name.matches('^[a-z0-9._-]{3,24}$')
        && !(name in ['admin', 'administrator', 'proxodon', 'proxoteca', 'moderator', 'support', 'staff', 'official', 'system'])
        && request.resource.data.keys().hasOnly(['uid'])
        && getAfter(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('nickname', '').lower() == name;
      allow delete: if owner(resource.data.uid);
    }
  }
}

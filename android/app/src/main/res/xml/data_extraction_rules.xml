<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: niente backup nel cloud né copia su un altro telefono dei dati dell'app (la WebView tiene
     la sessione Firebase e la cache dei mazzi). Sotto Android 12 basta allowBackup="false". -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
